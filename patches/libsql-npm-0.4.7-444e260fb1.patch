+// libSQL's native LibsqlConnection and its inner Connection both disconnect in
+// Drop. If the wrapper is the last connection owner, this can double-close the
+// SQLite handle during GC (Windows: 0xC0000005). Keep one unexecuted statement
+// alive while releasing the wrapper, so its independent connection owner is
+// dropped last. SELECT 1 holds no running cursor or transaction/file lock.
+// Track the native handles, never the JS Database, so abandoned transaction
+// connections can still be collected. Explicit close and GC share this path.
+const connectionLifetimes = new WeakMap();
+const liveConnections = new Set();
+
+function releaseConnection(lifetime) {
+  if (!liveConnections.has(lifetime)) return;
+  databaseClose.call(lifetime.handle);
+  liveConnections.delete(lifetime);
+}
+
+function releaseCollectedConnection(lifetime) {
+  try {
+    releaseConnection(lifetime);
+  } catch {
+    // Retain a failed native handle and its guard rather than letting GC tear
+    // it down in an unsafe order. Explicit close still propagates errors.
+  }
+}
+
+const collectedConnections = new FinalizationRegistry(releaseCollectedConnection);
+process.once("exit", () => {
+  for (const lifetime of liveConnections) releaseCollectedConnection(lifetime);
+});
